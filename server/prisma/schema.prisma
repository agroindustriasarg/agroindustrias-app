// Prisma Schema para Agroindustrias Argentinas SRL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== USUARIOS Y AUTENTICACIÓN ==========

model User {
  id        String   @id @default(uuid())
  usuario   String   @unique @default("")
  email     String   @unique
  password  String
  nombre    String
  apellido  String
  rol       UserRole @default(OPERARIO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  gastos    Gasto[]
  reportes  Reporte[]
  servicios Servicio[]

  @@map("usuarios")
}

enum UserRole {
  ADMIN
  GERENTE
  OPERARIO
  VISOR
}

// ========== CAMPOS Y LOTES ==========

model Campo {
  id          String   @id @default(uuid())
  nombre      String
  ubicacion   String
  hectareas   Float
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  lotes        Lote[]
  servicios    Servicio[]
  gastos       Gasto[]
  rendimientos Rendimiento[]
  ventas       VentaGrano[]

  @@map("campos")
}

model Lote {
  id          String   @id @default(uuid())
  nombre      String
  hectareas   Float
  cultivo     String?
  estado      String?  // En preparación, Sembrado, En crecimiento, Cosechado
  descripcion String?
  campoId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  campo        Campo         @relation(fields: [campoId], references: [id], onDelete: Cascade)
  servicios    Servicio[]
  gastos       GastoLote[]
  rendimientos Rendimiento[]

  @@map("lotes")
}

// ========== MAQUINARIAS ==========

model Maquinaria {
  id                String   @id @default(uuid())
  nombre            String
  tipo              String   // Tractor, Cosechadora, Sembradora, Fumigadora, etc.
  marca             String?
  modelo            String?
  anio              Int?
  patente           String?
  estado            String   @default("Operativa") // Operativa, En mantenimiento, Fuera de servicio
  horasUso          Float    @default(0)
  ultimoMantenimiento DateTime?
  proximoMantenimiento DateTime?
  descripcion       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  servicios        Servicio[]
  gastos           Gasto[]
  gastosImplemento Gasto[]    @relation("GastoImplemento")

  @@map("maquinarias")
}

// ========== CONTRATISTAS ==========

model Contratista {
  id          String   @id @default(uuid())
  nombre      String
  apellido    String?
  empresa     String?
  telefono    String?
  email       String?
  especialidad String? // Siembra, Fumigación, Cosecha, etc.
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  servicios Servicio[]

  @@map("contratistas")
}

// ========== SERVICIOS ==========

model Servicio {
  id            String    @id @default(uuid())
  tipo          String    // Siembra, Fumigación, Cosecha, Fertilización, etc.
  fecha         DateTime
  descripcion   String?
  hectareas     Float?
  costoPorHa    Float?    // Costo por hectárea
  total         Float?    // Total calculado (hectareas * costoPorHa)
  moneda        String    @default("ARS") // ARS o USD
  estado        String    @default("PENDIENTE") // PENDIENTE o REALIZADO
  facturable    Boolean   @default(true) // true = facturable, false = interno
  facturaId     String?   // Vincula el servicio a una factura cuando está facturado
  variedad      String?   // Variedad de semilla (para Siembra)
  tipoFertilizante String? // Tipo de fertilizante (para Fertilización)
  dosisKgHa     Float?    // Dosis cantidad (para Fertilización)
  unidadDosis   String?   // Unidad de dosis: kg/ha o kg/surco (para Fertilización)
  caldo         Float?    // Litros por hectárea de caldo (para Pulverización)
  receta        String?   // JSON con array de productos [{producto, cantidad, unidad}] (para Pulverización)
  campoId       String
  loteId        String?
  maquinariaId  String?
  contratistaId String?
  usuarioId     String?
  campanaId     String?   // Campaña a la que pertenece el servicio
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  campo       Campo        @relation(fields: [campoId], references: [id], onDelete: Cascade)
  lote        Lote?        @relation(fields: [loteId], references: [id], onDelete: SetNull)
  maquinaria  Maquinaria?  @relation(fields: [maquinariaId], references: [id], onDelete: SetNull)
  contratista Contratista? @relation(fields: [contratistaId], references: [id], onDelete: SetNull)
  usuario     User?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  factura     Factura?     @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  campana     Campana?     @relation(fields: [campanaId], references: [id], onDelete: SetNull)

  @@map("servicios")
}

// ========== STOCK E INSUMOS ==========

model Stock {
  id            String   @id @default(uuid())
  nombre        String
  categoria     String   // Semillas, Fertilizantes, Agroquímicos, Combustible, Repuestos
  cantidad      Float
  unidad        String   // kg, litros, unidades, etc.
  precioUnitario Float?
  stockMinimo   Float?
  ubicacion     String?
  descripcion   String?

  // Campos específicos para Agroquímicos
  droga         String?  // Droga activa
  nombreComercial String? // Nombre comercial
  tipo          String?  // Herbicida, Insecticida, Fertilizante, Fungicida

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  movimientos   MovimientoStock[]
  facturasItems FacturaItem[]

  @@index([categoria])
  @@map("stock")
}

model MovimientoStock {
  id          String   @id @default(uuid())
  stockId     String
  tipo        String   // ENTRADA, SALIDA
  cantidad    Float
  motivo      String?  // Compra, Uso en campo, Ajuste, etc.
  fecha       DateTime @default(now())
  observaciones String?

  // Campos para ENTRADA
  precio          Float?
  proveedor       String?
  precioUnitario  Float?
  tipoFactura     String?
  numeroRemito    String?
  numeroFactura   String?
  cuentaId        String?

  // Campos para SALIDA
  maquinariaId    String?
  implementoId    String?
  servicioId      String?
  campoId         String?
  loteId          String?
  campanaId       String?

  createdAt   DateTime @default(now())

  // Relaciones
  stock   Stock   @relation(fields: [stockId], references: [id], onDelete: Cascade)
  cuenta  Cuenta? @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  campana Campana? @relation(fields: [campanaId], references: [id], onDelete: SetNull)
  facturasItems FacturaItem[]

  @@index([stockId, createdAt])
  @@map("movimientos_stock")
}

// ========== FACTURAS ==========

model Factura {
  id             String   @id @default(uuid())
  numeroFactura  String   @unique
  fechaEmision   DateTime
  proveedor      String
  tipoFactura    String   // A, B, C
  moneda         String   // ARS, USD
  tipoCambio     Float?   // Tipo de cambio USD → ARS (solo para facturas en USD)
  subtotal       Float    @default(0) // Subtotal sin IVA
  iva105         Float    @default(0) // Monto de IVA 10.5%
  iva21          Float    @default(0) // Monto de IVA 21%
  otrosCargos    Float    @default(0) // Percepciones, retenciones u otros cargos adicionales
  total          Float    // Total final (subtotal + iva105 + iva21 + otrosCargos)
  formaPago      String   // Contado, Cheque, Canje de granos, A pagar en fecha
  fechaPago      DateTime? // Solo si formaPago es "A pagar en fecha"
  estado         String   @default("PENDIENTE") // PENDIENTE, PAGADA
  tieneRemitos   Boolean  @default(false) // true = vinculada a remitos, false = factura simple
  observaciones  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  items     FacturaItem[]
  pagos     PagoFactura[]
  servicios Servicio[]

  @@map("facturas")
}

model FacturaItem {
  id                String   @id @default(uuid())
  facturaId         String
  movimientoStockId String?  // Remito al que pertenece (opcional)
  stockId           String?  // Producto específico del remito (opcional)
  cantidad          Float    // Cantidad del producto en esta factura
  precioUnitario    Float    // Precio por unidad para este producto
  precioTotal       Float    // Precio total para este producto en la factura (cantidad * precioUnitario)
  createdAt         DateTime @default(now())

  // Relaciones
  factura         Factura          @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  movimientoStock MovimientoStock? @relation(fields: [movimientoStockId], references: [id], onDelete: Cascade)
  stock           Stock?           @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("facturas_items")
}

model Pago {
  id            String   @id @default(uuid())
  cuentaId      String
  formaPago     String   // Transferencia, Cheque, Efectivo, etc.
  fechaPago     DateTime
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  cuenta   Cuenta        @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  facturas PagoFactura[]

  @@map("pagos")
}

model PagoFactura {
  id          String   @id @default(uuid())
  pagoId      String
  facturaId   String
  monto       Float    @default(0) // Monto imputado (en la moneda del pago: ARS o USD)
  monedaPago  String   @default("ARS") // ARS o USD
  tipoCambio  Float?   // TC usado si se pagó en ARS una factura USD
  montoUSD    Float?   // Equivalente en USD (monto / tipoCambio) si se pagó en ARS
  createdAt   DateTime @default(now())

  // Relaciones
  pago    Pago    @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@unique([pagoId, facturaId])
  @@map("pagos_facturas")
}

// ========== CUENTAS ==========

model Cuenta {
  id          String   @id @default(uuid())
  nombre      String   @unique
  tipo        String   // EMPRESA, PERSONAL, TERCEROS
  titular     String?  // Nombre del titular si es personal
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  gastos             Gasto[]
  movimientosStock   MovimientoStock[]
  pagos              Pago[]

  @@map("cuentas")
}

// ========== CAMPAÑAS ==========

model Campana {
  id        String   @id @default(uuid())
  cultivo   String
  anio      String
  nombre    String   @unique // "Soja 25/26"
  createdAt DateTime @default(now())

  gastos      Gasto[]
  servicios   Servicio[]
  movimientos MovimientoStock[]
  ventas      VentaGrano[]

  @@map("campanas")
}

// ========== GASTOS ==========

model Gasto {
  id             String    @id @default(uuid())
  concepto       String
  categoria      String    // Combustible, Mantenimiento, Insumos, Salarios, Servicios, Otros
  monto          Float
  fecha          DateTime
  descripcion    String?
  tipoFactura    String?   // A, B, C, Sin Factura
  numeroFactura  String?
  cuentaId       String?   // Cuenta que realizó el gasto
  campoId        String?
  maquinariaId   String?
  implementoId   String?
  usuarioId      String?
  grupoId        String?   // ID compartido entre gastos distribuidos del mismo origen
  campanaId      String?   // Campaña a la que pertenece el gasto
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relaciones
  cuenta      Cuenta?     @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  campo       Campo?      @relation(fields: [campoId], references: [id], onDelete: SetNull)
  lotes       GastoLote[]
  maquinaria  Maquinaria? @relation(fields: [maquinariaId], references: [id], onDelete: SetNull)
  implemento  Maquinaria? @relation("GastoImplemento", fields: [implementoId], references: [id], onDelete: SetNull)
  usuario     User?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  campana     Campana?    @relation(fields: [campanaId], references: [id], onDelete: SetNull)

  @@index([grupoId])
  @@map("gastos")
}

// Tabla intermedia para relación muchos-a-muchos entre Gastos y Lotes
model GastoLote {
  id       String @id @default(uuid())
  gastoId  String
  loteId   String
  createdAt DateTime @default(now())

  // Relaciones
  gasto Gasto @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  lote  Lote  @relation(fields: [loteId], references: [id], onDelete: Cascade)

  @@unique([gastoId, loteId])
  @@map("gastos_lotes")
}

// ========== RENDIMIENTOS ==========

model Rendimiento {
  id                  String   @id @default(uuid())
  campana             String   // "24/25", "25/26"
  campoId             String
  loteId              String
  cultivo             String   // Soja, Maíz, Poroto, etc.
  variedad            String?  // Ej: 6320, 7976
  fecha               DateTime
  kgBrutos            Float
  hectareasGrupo      Float?   // Ha parciales del grupo (cultivo+variedad) dentro del lote
  descCuerposExtranos Float    @default(0)
  descQuebrados       Float    @default(0)
  descTotalDaniados   Float    @default(0)
  descHumedad         Float    @default(0)
  descVolatil         Float    @default(0)
  descTemperatura     Float    @default(0)
  descGranosVerdes    Float    @default(0)
  kgNetos             Float
  destinoId           String?
  numeroCTG           String?
  observaciones       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campo   Campo    @relation(fields: [campoId], references: [id], onDelete: Cascade)
  lote    Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  destino Destino? @relation(fields: [destinoId], references: [id], onDelete: SetNull)

  @@map("rendimientos")
}

model Destino {
  id           String        @id @default(uuid())
  nombre       String        @unique
  createdAt    DateTime      @default(now())
  rendimientos Rendimiento[]

  @@map("destinos")
}

// ========== VENTAS DE GRANOS ==========

model VentaGrano {
  id                  String    @id @default(uuid())
  tipo                String    @default("VENTA") // VENTA, CANJE
  fecha               DateTime
  numeroLiquidacion   String?
  grano               String    // SOJA, MAIZ, TRIGO, GIRASOL, SORGO
  grado               String?   // G2, etc.
  kgEntregados        Float
  precioTn            Float     // precio pizarra $/tn (o precio implícito del canje)
  fleteTn             Float?    // flete por tn (solo ventas)
  retenciones         Float?    // total retenciones AFIP $ (solo ventas)
  otrasRetenciones    Float?    // retenciones provinciales (IIBB, etc.) $ (solo ventas)
  deducciones         Float?    // otras deducciones (sellado, etc.) $ (solo ventas)
  subtotalCanje       Float?    // subtotal del canje (kg/tn × precio)
  ivaCanje            Float?    // IVA del canje
  gastosAdminCanje    Float?    // gastos administrativos del canje
  importeNeto         Float     // importe neto a pagar / valor total del canje
  monedaPrecio        String    @default("ARS") // ARS o USD
  numeroContrato      String?   // N° de contrato o romaneo de transferencia
  destino             String?   // AGD, COFCO, Bayer SA, etc.
  campanaId           String?
  campoId             String?
  observaciones       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  campana Campana? @relation(fields: [campanaId], references: [id], onDelete: SetNull)
  campo   Campo?   @relation(fields: [campoId], references: [id], onDelete: SetNull)

  @@map("ventas_granos")
}

// ========== REPORTES ==========

model Reporte {
  id          String   @id @default(uuid())
  titulo      String
  tipo        String   // Producción, Gastos, Servicios, Inventario
  contenido   String   // JSON con datos del reporte
  fechaDesde  DateTime?
  fechaHasta  DateTime?
  usuarioId   String?
  createdAt   DateTime @default(now())

  // Relaciones
  usuario User? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("reportes")
}

// ========== CHEQUERA ==========

model Cheque {
  id              String   @id @default(uuid())
  numeroCheque    String
  fechaEmision    DateTime
  fechaVencimiento DateTime
  monto           Float
  moneda          String   @default("ARS") // ARS o USD
  banco           String
  beneficiario    String
  cruzado         Boolean  @default(false)
  estado          String   @default("PENDIENTE") // PENDIENTE, PAGADO
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cheques")
}

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())

  @@map("proveedores")
}
